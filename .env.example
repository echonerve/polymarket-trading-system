# Copy this file to ".env" (same folder). The .env file is read automatically.
# NEVER commit .env to git or share it. Add it to .gitignore.

# ── AI brain (optional) ──────────────────────────────────────────────────
# Needed only for `python bot.py --ai`. Set AI_PROVIDER in config.py to match.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── LIVE TRADING (real money) ────────────────────────────────────────────
# These are ONLY needed by whoever runs the bot live, on Polymarket, in a
# jurisdiction where it is permitted for them. Leave blank for paper/dry-run.
#
# SECURITY — read this:
#   * A private key IS the wallet. Anyone who sees it can drain it instantly.
#   * Use a DEDICATED wallet funded with only what you can afford to lose.
#   * Never paste this key into a chat, a doc, a screenshot, or a repo.
#   * If you ever get a TLS/certificate error, STOP. Do not disable verification.
#     A cert error means the connection is being intercepted.
POLYMARKET_PK=
FUNDER_ADDRESS=
SIGNATURE_TYPE=1          # 0 = MetaMask, 1 = Polymarket email wallet, 2 = Safe

# Final safety switch. Live orders are sent ONLY if this is exactly YES *and*
# the bot is run with --live. Leave it blank/NO to stay in dry-run.
LIVE_ARMED=
